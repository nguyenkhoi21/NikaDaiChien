[["kindId", "page", "no", "name", "text", "resId", "effect"], [1, 1, 1, "路飞", "呜呜呜", "1_1", 1], [2, 1, 2, "香克斯", "这是我很重要的帽子，好好珍惜噢。", "1_2", 1], [3, 1, 3, null, "多年后....", "1_3", 1], [4, 1, 4, "玛琪诺", "终于走了呢，村长，要变冷清了啊", "1_4", 1], [5, 1, 5, "村长", "真是村子的耻辱，居然要去当海贼！", "1_5", 1], [6, 1, 6, "路飞", "今天真是个适合出海的日子！", "1_6", 1], [7, 1, 7, "路飞", "近海之王？！你选错对手了！", "1_7", 1], [8, 1, 8, "近海之王", "吼吼吼！", "1_8", 2], [9, 1, 9, "路飞", "让你看看我练了十年的招式！橡胶手枪！！", "1_9", 2], [10, 1, 10, "路飞", "哼！知道我的厉害了吧！臭鱼！！", "1_10", 1], [11, 1, 11, "路飞", "海贼王！我当定了！！", "1_11", 1], [12, 2, 1, "路飞", "就是这里吗？关押着海贼猎人--诺诺罗亚·索隆的地方！", "2_1", 1], [13, 2, 2, "路飞", "找到了！就是这个家伙吧！只要解开那绳子就能轻易地放走他了吧？", "2_2", 1], [14, 2, 3, "索隆", "你看着很碍眼！给我滚！", "2_3", 1], [15, 2, 4, "路飞", "听说你是个坏人呢。被绑在这里示众，你真的很强嘛？", "2_4", 1], [16, 2, 5, "路飞", "我帮你解开绳子，你就来当我的同伴吧！我在寻找一起当海贼的同伴！", "2_5", 1], [17, 2, 6, "索隆", "我拒绝！你要我主动当坏人吗？别白费功夫了！", "2_6", 1], [18, 2, 7, "路飞", "你会用剑吧！我去帮你拿回来，所以你想要回剑的话，就只能当我的同伴了！", "2_7", 1], [19, 2, 8, "索隆", "你太坏心眼了！混蛋！！", "2_7", 1], [20, 2, 9, "蒙卡", "到此为止了！由于你们犯下叛乱罪，我要当场处决你们！", "2_8", 1], [21, 2, 10, "蒙卡", "居然敢在我的地盘上撒野！！开枪！！", "2_8", 1], [22, 2, 11, "路飞", "没用的！！我不是说了吗，我很强的！", "2_9", 1], [23, 2, 12, "路飞", "你会接受吧！你在这里与我并肩作战的话，就会成为反抗政府的坏蛋。", "2_10", 1], [24, 2, 13, "路飞", "或者是这样被海军所杀，你觉得怎么比较好呢？！", "2_10", 1], [25, 2, 14, "索隆", "我答应你当一个海贼，既然与海军必有一战，我也就名正言顺的成为坏蛋了！", "2_11", 2], [26, 2, 15, "索隆", "不过，话说在前头，我要成为世界第一的剑豪，要是你害我无法实现这个野心的话，到时候你就切腹向我赔罪吧！", "2_11", 2], [27, 2, 16, "路飞", "索隆，干得好！", "2_12", 1], [28, 2, 17, "索隆", "小意思，船长！！", "2_12", 1], [29, 2, 18, "海军士兵", "不用在受蒙卡支配了！万岁！！谢谢你们！", "2_13", 1], [30, 2, 19, "路飞", "海贼团终于要出航了，前面似乎会有跟惊心动魄的冒险在等着我们呢！", "2_14", 1], [31, 3, 1, "巴基", "伟大航路的海图还没有找到么？再说为什么海图会那么轻易的被人偷走呢？！", "3_1", 1], [32, 3, 2, "巴基", "我们可正打算驶向伟大航路大展拳脚！", "3_1", 1], [33, 3, 3, "娜美", "巴基船长，我和老大闹翻了，海图还给您。", "3_2", 1], [34, 3, 4, "娜美", "请让我加入你们巴基一伙吧。", "3_2", 1], [35, 3, 5, "巴基", "闹翻了？！有意思！那就让你加入巴基一伙吧！", "3_3", 1], [36, 3, 6, "巴基", "好！大家为娜美办一个欢迎会吧！华丽的大闹一场！", "3_3", 1], [37, 3, 7, "巴基", "给娜美一个巴基弹，让她把前老大炸了。当然这同时还包含着发誓效忠老子的意思！", "3_4", 1], [38, 3, 8, "巴基", "动手！这就是我们的欢迎会！可别让我们扫兴啊！", "3_4", 1], [39, 3, 9, "路飞", "怎么了，你的手在抖啊！因为你没有彻底的觉悟，就想挑战海贼才会变成这样的！", "3_5", 1], [40, 3, 10, "路飞", "要有赌上性命的觉悟！", "3_5", 1], [41, 3, 11, "巴基", "愚弄人也要有个程度吧！小丫头！！给我华丽的杀了她！", "3_6", 2], [42, 3, 12, "索隆", "这么多人欺负一个女人算什么啊！", "3_7", 2], [43, 3, 13, "巴基", "你就是索隆吗？你来干什么？难不成是来取我的脑袋的吗？！", "3_8", 1], [44, 3, 14, "索隆", "不！我对你没有兴趣！我不干海贼猎人了！", "3_8", 1], [45, 3, 15, "路飞", "居然从背后偷袭！太卑鄙了！大鼻子！！", "3_9", 1], [46, 3, 16, "巴基", "你！说！谁！是！大鼻子！！", "3_9", 1], [47, 3, 17, "路飞", "好险！好险！差点就被打到了！", "3_10", 1], [48, 3, 18, "路飞", "橡胶！锥！", "3_11", 1], [49, 3, 19, "路飞", "飞吧！巴基！橡胶！火箭炮！！", "3_12", 2], [50, 3, 20, "人群", "居然把我们的小镇弄成这样！绝对不能放过他们！！", "3_13", 1], [51, 3, 21, "路飞", "开溜了！！", "3_13", 1], [52, 3, 22, "镇长", "臭小鬼们！感恩不尽！！千言万语，感恩不尽！！", "3_14", 1], [53, 3, 23, "路飞", "别在意！放轻松点！！", "3_14", 1], [54, 4, 1, "乌索普", "如果你们想攻打这个村子的话，我劝你们还是放弃吧！", "4_1", 1], [55, 4, 2, "乌索普", "因为我那八千万部下是不会放过你们的！", "4_1", 1], [56, 4, 3, "娜美", "骗人的吧！毕竟没看过用弹弓的海贼啊！", "4_2", 1], [57, 4, 4, "乌索普", "我的弹弓本领可是比一般的手枪都要厉害多了！", "4_3", 1], [58, 4, 5, "路飞", "既然拔枪了！就要赌上性命啊！这东西可不是用来吓唬人的玩具！！", "4_4", 1], [59, 4, 6, "索隆", "站在你面前的可是真正的海贼啊！", "4_4", 1], [60, 4, 7, "乌索普", "这就是真正的海贼吗！说话的气势就是不同凡响！好厉害！！", "4_5", 1], [61, 4, 8, "路飞", "现学现卖啦！是学我所尊敬的海贼香克斯的话！", "4_6", 1], [62, 4, 9, "路飞", "你爸爸是耶稣布对吧！", "4_6", 1], [63, 4, 10, "乌索普", "耶稣布的确是我老爸的名字！不过你怎么知道的！", "4_6", 1], [64, 4, 11, "路飞", "小时候我见到过，你爸爸在香克斯的船上！", "4_6", 1], [65, 4, 12, "娜美", "我们来这边是想找一个能操作船的伙伴和一艘大一点的船！", "4_7", 1], [66, 4, 13, "乌索普", "你也看到了，这里是一个小村庄，没有你想要的东西啦！", "4_7", 1], [67, 4, 14, "索隆", "那边山坡上的别墅！看着很华丽，也许会有的吧！", "4_7", 1], [68, 4, 15, "路飞", "我有事相求！我们想要一艘大船！", "4_8", 1], [69, 4, 16, "克洛", "你们这样擅闯民宅让人很头痛啊！", "4_9", 1], [70, 4, 17, "克洛", "现在请你们出去吧！", "4_9", 1], [71, 4, 18, "克洛", "计划已经到这一步了，接下来不能有失误！", "4_10", 1], [72, 4, 19, "赞高", "到时你就快点发信号吧！兄弟们的船已经停在这附近一周了！已经快等的不耐烦了！！", "4_10", 1], [73, 4, 20, "克洛", "计划很快就能施展！你们做好进攻的准备吧！", "4_10", 1], [74, 4, 21, null, "两天后...", "4_11", 1], [75, 4, 22, "猫人--山姆", "你小子刚才在小瞧我吧！亏你能挡住！枉费我装了这么久！", "4_11", 1], [7